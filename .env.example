# Leave empty to use the default API.
# Web uses /api through Firebase Hosting rewrites.
# Native/Expo Go uses the deployed Cloud Function URL.
# Override this when pointing to another backend origin or function URL.
# Examples:
# EXPO_PUBLIC_API_BASE_URL=https://match-bb30c.web.app
# EXPO_PUBLIC_API_BASE_URL=https://us-central1-match-bb30c.cloudfunctions.net/api
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_FOOTBALL_DATA_API_TOKEN=
