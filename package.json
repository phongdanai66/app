{
  "name": "football-app1",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "deploy": "npm run build:web && firebase deploy",
    "deploy:hosting": "npm run build:web && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "functions:install": "npm --prefix functions install",
    "sync:firestore": "npm --prefix functions run sync:local",
    "sync:history:firestore": "node scripts/syncHistoricalMatchesToFirestore.js",
    "backtest:previous-season": "node scripts/backtestPreviousSeason.js",
    "backtest:gemini": "node scripts/runGeminiBacktest.js",
    "backtest:interpret": "node scripts/interpretConfusionMatrix.js",
    "sync:season:firestore": "node scripts/syncSeasonDataToFirestore.js",
    "refresh:season-data": "node scripts/refreshSeasonData.js",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@google/generative-ai": "^0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "axios": "^1.12.2",
    "expo": "~57.0.26",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.4.0",
    "openai": "^6.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-animatable": "^1.4.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "private": true
}
