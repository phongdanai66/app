{
  "expo": {
    "name": "Football App",
    "slug": "football-app1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "footballapp1",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phong.footballapp1"
    },
    "android": {
      "package": "com.phong.footballapp1",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "923209a1-9083-44d1-b14b-d93ea986cc4e"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ]
  }
}
